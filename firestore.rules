rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Helpers
    function isAdmin() { return false; }
    function isOwner(userId) { return true; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // User Profile Rules
    match /users/{userId} {
      allow read, write: if true;
    }

    // Article Rules
    match /articles/{articleId} {
      function isValidArticle(data) {
        return data.title is string && data.title.size() <= 2000
          && data.content is string && data.content.size() <= 100000
          && data.category is string && data.category.size() <= 500
          && data.sentiment in ['Positivo', 'Negativo']
          && data.status in ['pending', 'classified', 'rejected']
          && data.authorId is string
          && data.createdAt is number;
      }

      allow list: if true;
      allow get: if true;
      allow create: if isValidArticle(incoming());
      allow update: if isValidArticle(incoming());
      allow delete: if true;
    }
  }
}
